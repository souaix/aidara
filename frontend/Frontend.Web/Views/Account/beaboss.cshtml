@{
    ViewData["Title"] = "成為達人";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">成為達人</h1>
    <p class="text-center">填寫以下資訊，免費註冊，開始提供服務</p>

    <div class="text-center">
        <button class="btn btn-primary" id="openRegisterModal">免費註冊</button>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">達人註冊問卷</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Step Content -->
                <div id="step1" class="step">
                    <h5>Step 1. 選擇服務分類</h5>
                    <div class="btn-group d-flex flex-wrap">
                        <button class="btn btn-outline-secondary m-1">居家</button>
                        <button class="btn btn-outline-secondary m-1">學習</button>
                        <button class="btn btn-outline-secondary m-1">活動</button>
                        <button class="btn btn-outline-secondary m-1">健康</button>
                        <button class="btn btn-outline-secondary m-1">商業</button>
                        <button class="btn btn-outline-secondary m-1">其他</button>
                    </div>
                </div>

                <div id="step2" class="step d-none">
                    <h5>Step 2. 選擇服務細項</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 室內裝潢</label>
                        <label class="list-group-item"><input type="checkbox" /> 家電維修</label>
                        <label class="list-group-item"><input type="checkbox" /> 瑜珈課程</label>
                        <label class="list-group-item"><input type="checkbox" /> 健身教練</label>
                    </div>
                </div>

                <div id="step3" class="step d-none">
                    <h5>Step 3. 選擇相關服務</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 防身術</label>
                        <label class="list-group-item"><input type="checkbox" /> CPR訓練</label>
                        <label class="list-group-item"><input type="checkbox" /> 伴讀/陪玩</label>
                    </div>
                </div>

                <div id="step4" class="step d-none">
                    <h5>Step 4. 選擇服務方式</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 我可以上門服務</label>
                        <label class="list-group-item"><input type="checkbox" /> 客戶到我的據點</label>
                        <label class="list-group-item"><input type="checkbox" /> 網路/電話服務</label>
                    </div>
                </div>

                <div id="step5" class="step d-none">
                    <h5>Step 5. 服務據點</h5>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <input class="form-control" placeholder="縣/市 (CITY)" />
                        </div>
                        <div class="col-md-6">
                            <input class="form-control" placeholder="區/鄉鎮 (DISTRICT)" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <input class="form-control" placeholder="路名 (STREET)" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" placeholder="門牌號碼 (ADDRESS_NO)" />
                        </div>
                    </div>
                </div>

                <div id="step6" class="step d-none">
                    <h5>Step 6. 服務範圍</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 台灣全區</label>
                        <label class="list-group-item"><input type="checkbox" /> 台北市 大安區</label>
                        <label class="list-group-item"><input type="checkbox" /> 新北市 板橋區</label>
                        <label class="list-group-item"><input type="checkbox" /> 宜蘭縣 羅東鎮</label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" id="prevStep" disabled>上一步</button>
                <button class="btn btn-primary" id="nextStep">下一步</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 1;
        const totalSteps = 6;

        document.getElementById("openRegisterModal").addEventListener("click", () => {
            new bootstrap.Modal(document.getElementById("registerModal")).show();
        });

        document.getElementById("nextStep").addEventListener("click", () => {
            if (currentStep < totalSteps) {
                document.getElementById("step" + currentStep).classList.add("d-none");
                currentStep++;
                document.getElementById("step" + currentStep).classList.remove("d-none");
                document.getElementById("prevStep").disabled = false;
                if (currentStep === totalSteps) {
                    document.getElementById("nextStep").textContent = "完成";
                }
            } else {
                // TODO: 提交表單
                alert("註冊完成！");
                bootstrap.Modal.getInstance(document.getElementById("registerModal")).hide();
            }
        });

        document.getElementById("prevStep").addEventListener("click", () => {
            if (currentStep > 1) {
                document.getElementById("step" + currentStep).classList.add("d-none");
                currentStep--;
                document.getElementById("step" + currentStep).classList.remove("d-none");
                document.getElementById("nextStep").textContent = "下一步";
                if (currentStep === 1) {
                    document.getElementById("prevStep").disabled = true;
                }
            }
        });
    </script>
}
