@using System.Security.Claims
@* @{
    var currentMode = User.FindFirst("active_mode")?.Value ?? "CUSTOMER3";
} *@

<header>
    <nav class="navbar navbar-expand-lg bg-white shadow-sm fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">SamaSama</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">首頁</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Map" asp-action="Index">地圖找案件</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Stripe" asp-action="Test" target="_blank">Stripe 測試</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="CustomerServices" asp-action="BossMode">小老闆模式</a></li>
                </ul>

                <div class="d-flex gap-2">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <input type="hidden" id="currentUserId" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
                        <span class="navbar-text me-2">@User.Identity.Name</span>

                        <li class="nav-item">
                            <a class="btn btn-outline-primary ms-2"
                               asp-controller="CustomerServices"
                               asp-action="RequestService">
                                徵求服務
                            </a>
                        </li>
                        <a class="btn btn-outline-secondary"
                           asp-controller="Account"
                           asp-action="Logout"
                           asp-route-returnUrl="@Context.Request.Path">登出</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">登入</a>
                    }

                    <li class="nav-item">
                        <a class="btn btn-primary" asp-controller="BossServices" asp-action="Beaboss">成為達人</a>
                    </li>

                    <!-- 🔽 模式切換下拉 -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            模式：<span id="current-mode-label"></span>
                        </a>
                        <ul class="dropdown-menu" id="role-switch-menu">
                            <li><span class="dropdown-item text-muted">載入中...</span></li>
                        </ul>
                    </li>
                </div>
            </div>
        </div>
    </nav>
</header>

<!-- Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title">登入或註冊</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="text-muted small mb-3">選擇你要使用的方式：</p>
                <div class="d-grid gap-2">
                    <button type="button" class="gsi-btn"
                            onclick="location.href='@Url.Action("Google", "Account", new { mode = "login", returnUrl = Context.Request.Path })'">
                        <span class="gsi-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 31.9 29.2 35 24 35c-6.1 0-11-4.9-11-11s4.9-11 11-11c2.8 0 5.4 1.1 7.4 2.8l5.7-5.7C33.6 7 29 5 24 5 13 5 4 14 4 25s9 20 20 20c10.5 0 19.3-7.6 19.3-20 0-1.3-.1-2.2-.3-3.5z" />
                                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 14 24 14c2.8 0 5.4 1.1 7.4 2.8l5.7-5.7C33.6 7 29 5 24 5 16.1 5 9.3 9.5 6.3 14.7z" />
                                <path fill="#4CAF50" d="M24 45c5 0 9.6-1.9 13-5.1l-6-4.9c-2 1.4-4.7 2.3-7 2.3-5.2 0-9.7-3.3-11.3-7.9l-6.5 5C9.1 40.4 16 45 24 45z" />
                                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.4-3.8 6.1-7.3 7.5l6 4.9c3.6-3.3 6.6-8.2 6.6-15 0-1.3-.1-2.2-.3-3.5z" />
                            </svg>
                        </span>
                        <span class="gsi-text">使用 Google 帳戶登入</span>
                    </button>
                </div>
            </div>

            <div class="modal-footer justify-content-between">
                <span class="text-muted small">登入/註冊即表示你同意本站的服務條款與隱私權政策</span>
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<script>
    
    let pendingRoleName = null;// 🌟 暫存即將切換的角色名稱

    async function getActiveMode(userId) {
      try {
        const res = await fetch(`${API_BASE}/api/UserRole/user/${userId}/active-mode`);
        if (!res.ok) {
          console.warn("⚠️ 無法取得 active-mode", res.status);
          return "CUSTOMER";
        }
        const json = await res.json();
        return json.roleId || "CUSTOMER";
      } catch (err) {
        console.error("🚨 讀取 active-mode 發生錯誤:", err);
        return "CUSTOMER";
      }
    }

    async function loadAvailableRoles() {
      const userId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
      if (!userId) return;

      try {
        // ① 載入角色清單
        const rolesRes = await fetch(`${API_BASE}/api/UserRole/user/${userId}/available-roles`);
        if (!rolesRes.ok) {
          console.warn("⚠️ 取得可用角色失敗", rolesRes.status);
          return;
        }
        const roles = await rolesRes.json();

        // ② 取得當前 active-mode
        const activeCode = await getActiveMode(userId);

        // ③ Render 下拉與目前中文名稱
        renderSwitchMenu(roles, activeCode);
      } catch (err) {
        console.error("🚨 無法載入角色清單:", err);
      }
    }

    function renderSwitchMenu(roles, activeCode) {
      const menu = document.getElementById("role-switch-menu");
      const currentModeEl = document.getElementById("current-mode-label");

      if (!roles || !roles.length) {
        menu.innerHTML = `<li><span class="dropdown-item text-muted">無可用角色</span></li>`;
        currentModeEl.textContent = "顧客";
        return;
      }

      menu.innerHTML = roles.map(r =>
        `<li><a class="dropdown-item" href="#" onclick="switchMode('${r.roleId}','${r.roleName}')">${r.roleName}</a></li>`
      ).join('');

    // 🌟 優先顯示 pendingRoleName（防止閃回 CUSTOMER）
    const showName = pendingRoleName
      ?? (roles.find(r => r.roleId === activeCode)?.roleName ?? "顧客");

    currentModeEl.textContent = showName;

      // 設定目前中文模式
      const activeRole = roles.find(r => r.roleId === activeCode);
      currentModeEl.textContent = activeRole ? activeRole.roleName : "顧客";
    }

    async function switchMode(roleId, roleName) {
      const userId = "@User.FindFirstValue(ClaimTypes.NameIdentifier)";
      if (!userId) return;

      console.log("🌀 切換模式中 →", roleId);

    // 🌟 立即更新暫存名稱避免閃爍
    pendingRoleName = roleName;
    document.getElementById("current-mode-label").textContent = roleName;

      // ✅ 呼叫 switch-active-mode
      const resp = await fetch(`${API_BASE}/api/UserRole/user/${userId}/switch-active-mode`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ roleId })
      });

      if (!resp.ok) {
        alert("切換失敗");
        console.warn("⚠️ switch-active-mode failed", resp.status);
        pendingRoleName = null;
        return;
      }

      // ✅ 立即顯示新中文名稱
      document.getElementById("current-mode-label").textContent = roleName;

      // ✅ 再次呼叫 active-mode 以確認更新成功
      const active = await getActiveMode(userId);
      console.log("🧭 ActiveMode after switch:", active);

      // ✅ 平滑 redirect（方案B）
      document.body.classList.add("fade-out");
      setTimeout(() => window.location.href = window.location.pathname, 400);
    }

    document.addEventListener("DOMContentLoaded", loadAvailableRoles);
</script>

<style>
    body.fade-out {
        opacity: 0.4;
        transition: opacity 0.3s ease;
    }
</style>

