@model string
@{
    var type = TempData["FlashType"] as string ?? "info"; // 可用：success / info / error
}

<div class="flash-banner-container">
    <div class="flash-banner card shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span>@Model</span>
            <button type="button" class="btn-close ms-3" aria-label="Close" onclick="this.closest('.flash-banner')?.remove()"></button>
        </div>
    </div>
</div>

<style>
    .flash-banner-container {
        position: fixed;
        top: 40px;
        left: 40%;
   
        z-index: 9999;
        pointer-events: none; /* 不擋住滑鼠點擊頁面其他地方 */
    }

    .flash-banner {
        background-color: white;
        border-radius: 0.5rem;
        padding: 1.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
        animation: fadeIn 0.5s ease-in-out;
        min-width: 300px;
        max-width: 600px;
        pointer-events: auto; /* 讓自己可以點擊關閉按鈕 */
    }

        .flash-banner span {
            word-break: break-word;
            max-width: 100%;
            font-size: 1.5rem;
            text-align: center;
        }



    }
</style>

<script>
    setTimeout(() => {
        document.querySelector('.flash-banner')?.remove();
    }, 5000); // 5 秒自動消失
</script>
