@*
  全站框架：Bootstrap + 可插入的 Partial
*@
<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SamaSama</title>
    

    <!-- Quill 核心樣式 -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <!-- Quill 核心腳本 -->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/home.css?v=5" />  @* ← 加個版本號清快取 *@
    @RenderSection("styles", required: false)
    @* <link rel="stylesheet" href="~/css/site.css" /> *@


    @RenderSection("styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100 pt-navbar">
    @* @{
        // 測試用：強制顯示 flash banner，之後請拿掉這段
        var fakeFlashMessage = TempData["FlashMessage"] as string ?? "🎉 測試訊息：銀幣發送成功";
    } *@

@if (TempData["FlashMessage"] is string msg)
{
    <partial name="~/Views/Shared/Partials/_FlashBanner.cshtml" model="msg" />
}

    @Html.Partial("~/Views/Shared/Partials/_Header.cshtml")
    

    <main role="main">
        @RenderBody()
    </main>

    @Html.Partial("~/Views/Shared/Partials/_Footer.cshtml")

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/alarmMessage.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    @RenderSection("scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          const params = new URLSearchParams(location.search);
          if (params.get('auth') === '1') {
            const modalEl = document.getElementById('loginModal');
            if (modalEl) new bootstrap.Modal(modalEl).show();
          }
        });

        //flash-banner
        // setTimeout(() => {
        //     document.querySelectorAll(".flash-banner")?.forEach(b => b.remove());
        // }, 5000); 
        // //5 秒後自動消失
    </script>


    @* <script src="https://accounts.google.com/gsi/client" async defer></script> *@

    @* @if (TempData["FlashMessage"] is string msg)
    {
        var type = TempData["FlashType"] as string ?? "info";
        <div class="alert alert-@type alert-dismissible fade show flash-banner" role="alert">
            @msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    } *@


    @* 🔽 Razor 先在伺服端產生 JSON (放在 <text> 包起來避免破壞 HTML 結構) *@
    @{
        var roleJson = System.Text.Json.JsonSerializer.Serialize(
        User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList()
        );
    }

    <script>
        const API_BASE = "https://localhost:7030";

        (async function () {
            try {
                const roles = @Html.Raw(roleJson);
                const activeMode = "@(User.FindFirst("active_mode")?.Value ?? "CUSTOMER")";

                console.log("🧾 Current Roles:", roles);
                console.log("🎭 Active Mode:", activeMode);

                // 🚫 如果這次不是剛登入（或已經刷新過），直接跳過
                if (sessionStorage.getItem("claimsRefreshed") === "true") {
                    console.log("🟢 Claims already refreshed in this session, skipping auto-refresh.");
                    return;
                }

                // ✅ 只在第一次登入後自動執行 refresh（沒有角色或模式是 CUSTOMER）
                if ((!roles.length || roles.includes("CUSTOMER")) && activeMode === "CUSTOMER") {
                    console.log("🔄 Refreshing claims...");
                    const resp = await fetch(`${API_BASE}/Account/RefreshClaims`, { credentials: "include" });

                    if (resp.ok) {
                        sessionStorage.setItem("claimsRefreshed", "true");
                        console.log("✅ Claims refreshed, reloading page...");
                        window.location.reload();
                    } else {
                        console.warn("⚠️ RefreshClaims failed:", resp.status);
                    }
                }
            } catch (err) {
                console.error("❌ RefreshClaims error:", err);
            }
        })();

        // 🧹 可選：當使用者登出時清掉旗標，確保下次登入會重新 refresh
        document.addEventListener("click", (e) => {
            if (e.target.matches('a[href*="/Account/Logout"]')) {
                sessionStorage.removeItem("claimsRefreshed");
                console.log("🧹 Session flag cleared on logout.");
            }
        });
    </script>


    <!-- 全域訊息區：會出現在畫面上方中間 -->
    <div id="globalAlertContainer"
         class="position-fixed top-0 start-50 translate-middle-x p-3"
         style="z-index: 1080; min-width: 320px; max-width: 480px;">
    </div>

</body>
</html>
