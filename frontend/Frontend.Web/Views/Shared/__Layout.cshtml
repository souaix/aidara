<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Servara</title>
    <link rel="stylesheet" href="~/css/site.css" />

    <environment include="Development">
        <meta name="api-base" content="https://localhost:7030" />
    </environment>
    <environment exclude="Development">
        <!-- 佈署到同網域時讓它留空，走相對路徑 /api/.. -->
        <meta name="api-base" content="" />
    </environment>

</head>
<body>
    <header>
        <nav>
            <a href="/">首頁</a> |
            <a href="/Map">地圖檢索</a>
        </nav>
    </header>

    <main role="main" class="container">
        @RenderBody()
    </main>

    <footer>
        <hr />
        <p>&copy; 2025 - Servara 平台</p>
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>
