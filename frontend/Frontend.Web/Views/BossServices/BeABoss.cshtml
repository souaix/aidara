@{
    ViewData["Title"] = "成為達人";
    Layout = "_Layout";
}
@using System.Security.Claims
@{
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

@using System.Security.Claims
@{
    ViewData["Title"] = "小老闆模式";
    Layout = "_Layout";

    // 讀目前模式（由 /Account/SwitchMode 重簽 cookie 時更新）
    var activeMode = User.FindFirst("active_mode")?.Value ?? "CUSTOMER";

    // 只要目前模式含 BOSS 就顯示小老闆畫面
    bool isBoss = activeMode.Contains("BOSS", StringComparison.OrdinalIgnoreCase);

    Console.WriteLine($"ActiveMode: {activeMode}");
}

<div class="container mt-4">
    @if (!isBoss)
    {
        <!-- 未成為小老闆：顯示註冊問卷 -->
        @await Html.PartialAsync("_BossRegisterPartial")
    }
    else
    {
        <!-- 已是小老闆：顯示服務資訊 -->
        @await Html.PartialAsync("_BossDashboardPartial")
    }
</div>

@section Scripts {
    @if (!isBoss)
    {
        <partial name="_BossRegisterScript" />
    }
}
