@{
    ViewData["Title"] = "成為達人";
    Layout = "_Layout";
}
@using System.Security.Claims
@{
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

@using System.Security.Claims
@{
    ViewData["Title"] = "小老闆模式";
    Layout = "_Layout";

    var roles = User.Claims
        .Where(c => c.Type == ClaimTypes.Role)
        .Select(c => c.Value)
        .ToList();

    bool isBoss = roles.Any(r => r.Contains("BOSS", StringComparison.OrdinalIgnoreCase));

    Console.WriteLine($"User Roles: {string.Join(", ", roles)}");
}

<div class="container mt-4">
    @if (!isBoss)
    {
        <!-- 未成為小老闆：顯示註冊問卷 -->
        @await Html.PartialAsync("_BossRegisterPartial")
    }
    else
    {
        <!-- 已是小老闆：顯示服務資訊 -->
        @await Html.PartialAsync("_BossDashboardPartial")
    }
</div>

@section Scripts {
    @if (!isBoss)
    {
        <partial name="_BossRegisterScript" />
    }
}
