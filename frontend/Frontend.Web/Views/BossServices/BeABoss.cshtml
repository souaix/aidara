@{
    ViewData["Title"] = "成為達人";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">成為達人</h1>
    <p class="text-center">填寫以下資訊，免費註冊，開始提供服務</p>

    <div class="text-center">
        <button class="btn btn-primary" id="openRegisterModal">免費註冊</button>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">達人註冊問卷</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Step 1 -->
                <div id="step1" class="step">
                    <h5>Step 1. 選擇服務分類 / 中分類 / 項目</h5>
                    <div class="row">
                        <!-- 左側：大分類 -->
                        <div class="col-3 border-end">
                            <ul class="list-group" id="categoryList">
                                <li class="list-group-item text-muted">載入中...</li>
                            </ul>
                        </div>

                        <!-- 中側：中分類 -->
                        <div class="col-4 border-end">
                            <ul class="list-group" id="subcategoryList">
                                <li class="list-group-item text-muted">請先選擇大分類</li>
                            </ul>
                        </div>

                        <!-- 右側：服務項目 -->
                        <div class="col-5">
                            <ul class="list-group" id="itemList">
                                <li class="list-group-item text-muted">請先選擇中分類</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Step 2: 相關服務 -->
                <div id="step2" class="step d-none">
                    <h5>Step 2. 選擇相關服務</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 防身術</label>
                        <label class="list-group-item"><input type="checkbox" /> CPR訓練</label>
                        <label class="list-group-item"><input type="checkbox" /> 伴讀/陪玩</label>
                    </div>
                </div>

                <!-- Step 3: 服務方式 -->
                <div id="step3" class="step d-none">
                    <h5>Step 3. 選擇服務方式</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 我可以上門服務</label>
                        <label class="list-group-item"><input type="checkbox" /> 客戶到我的據點</label>
                        <label class="list-group-item"><input type="checkbox" /> 網路/電話服務</label>
                    </div>
                </div>

                <!-- Step 4: 服務據點 -->
                <div id="step4" class="step d-none">
                    <h5>Step 4. 服務據點</h5>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <input class="form-control" placeholder="縣/市 (CITY)" />
                        </div>
                        <div class="col-md-6">
                            <input class="form-control" placeholder="區/鄉鎮 (DISTRICT)" />
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <input class="form-control" placeholder="路名 (STREET)" />
                        </div>
                        <div class="col-md-4">
                            <input class="form-control" placeholder="門牌號碼 (ADDRESS_NO)" />
                        </div>
                    </div>
                </div>

                <!-- Step 5: 服務範圍 -->
                <div id="step5" class="step d-none">
                    <h5>Step 5. 服務範圍</h5>
                    <div class="list-group">
                        <label class="list-group-item"><input type="checkbox" /> 台灣全區</label>
                        <label class="list-group-item"><input type="checkbox" /> 台北市 大安區</label>
                        <label class="list-group-item"><input type="checkbox" /> 新北市 板橋區</label>
                        <label class="list-group-item"><input type="checkbox" /> 宜蘭縣 羅東鎮</label>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" id="prevStep" disabled>上一步</button>
                <button class="btn btn-primary" id="nextStep">下一步</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        let categories = [];
        const selectedItems = new Set();
        let currentStep = 1;
        const totalSteps = 5;

        // 讀取服務分類
        async function loadCategories() {
            try {
                const res = await fetch('https://localhost:7030/api/BossServices/categories');
                if (!res.ok) {
                    throw new Error("API 回應錯誤: " + res.status);
                }
                categories = await res.json();

                const catList = document.getElementById("categoryList");
                catList.innerHTML = "";
                if (categories.length === 0) {
                    catList.innerHTML = '<li class="list-group-item text-muted">沒有分類資料</li>';
                    return;
                }
                categories.forEach(c => {
                    const li = document.createElement("li");
                    li.className = "list-group-item category-item";
                    li.dataset.id = c.categoryId;
                    li.textContent = c.name;
                    catList.appendChild(li);
                });
            } catch (err) {
                console.error("讀取服務分類失敗:", err);
                document.getElementById("categoryList").innerHTML =
                    '<li class="list-group-item text-danger">載入失敗</li>';
            }
        }

        // 點大分類 → 載入中分類
        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("category-item")) {
                const catId = e.target.dataset.id;
                const cat = categories.find(c => c.categoryId === catId);

                const subList = document.getElementById("subcategoryList");
                subList.innerHTML = "";
                cat.subcategories.forEach(s => {
                    const li = document.createElement("li");
                    li.className = "list-group-item subcategory-item";
                    li.dataset.id = s.subcategoryId;
                    li.textContent = s.name;
                    subList.appendChild(li);
                });

                document.getElementById("itemList").innerHTML =
                    '<li class="list-group-item text-muted">請先選擇中分類</li>';
            }
        });

        // 點中分類 → 載入服務項目 (已勾選的排前面)
        document.addEventListener("click", function (e) {
            if (e.target.classList.contains("subcategory-item")) {
                const subId = e.target.dataset.id;
                const cat = categories.find(c => c.subcategories.some(s => s.subcategoryId === subId));
                const sub = cat.subcategories.find(s => s.subcategoryId === subId);

                const items = [...sub.items].sort((a, b) => {
                    const aSel = selectedItems.has(a.itemId);
                    const bSel = selectedItems.has(b.itemId);
                    return (aSel === bSel) ? 0 : (aSel ? -1 : 1);
                });

                const itemList = document.getElementById("itemList");
                itemList.innerHTML = "";
                items.forEach(i => {
                    const label = document.createElement("label");
                    label.className = "list-group-item";

                    const checkbox = document.createElement("input");
                    checkbox.type = "checkbox";
                    checkbox.className = "item-check";
                    checkbox.dataset.id = i.itemId;
                    if (selectedItems.has(i.itemId)) checkbox.checked = true;

                    checkbox.addEventListener("change", () => {
                        if (checkbox.checked) {
                            selectedItems.add(i.itemId);
                        } else {
                            selectedItems.delete(i.itemId);
                        }
                    });

                    label.appendChild(checkbox);
                    label.append(" " + i.name);
                    itemList.appendChild(label);
                });
            }
        });

        // Step 流程控制
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("openRegisterModal").addEventListener("click", () => {
                const modal = new bootstrap.Modal(document.getElementById("registerModal"));
                modal.show();
                loadCategories();
            });

            document.getElementById("nextStep").addEventListener("click", () => {
                if (currentStep < totalSteps) {
                    document.getElementById("step" + currentStep).classList.add("d-none");
                    currentStep++;
                    document.getElementById("step" + currentStep).classList.remove("d-none");
                    document.getElementById("prevStep").disabled = false;
                    if (currentStep === totalSteps) {
                        document.getElementById("nextStep").textContent = "完成";
                    }
                } else {
                    console.log("選取的服務項目:", Array.from(selectedItems));
                    alert("註冊完成！");
                    bootstrap.Modal.getInstance(document.getElementById("registerModal")).hide();
                }
            });

            document.getElementById("prevStep").addEventListener("click", () => {
                if (currentStep > 1) {
                    document.getElementById("step" + currentStep).classList.add("d-none");
                    currentStep--;
                    document.getElementById("step" + currentStep).classList.remove("d-none");
                    document.getElementById("nextStep").textContent = "下一步";
                    if (currentStep === 1) {
                        document.getElementById("prevStep").disabled = true;
                    }
                }
            });
        });
    </script>
}

