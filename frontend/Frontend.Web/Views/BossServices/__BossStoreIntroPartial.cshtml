@using System.Security.Claims
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<!-- Quill 核心 -->
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<!-- Image Resize 模組 -->
<script src="https://cdn.jsdelivr.net/npm/quill-image-resize-module@3.0.0/image-resize.min.js"></script>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">個人化介紹</h5>
            <button class="btn btn-sm btn-outline-primary" id="editIntroBtn">編輯</button>
        </div>

        <!-- 顯示區 -->
        <div id="storeContent" class="border rounded p-3" style="min-height:200px;">
            <div class="text-muted">載入中...</div>
        </div>

        <!-- 編輯區（初始隱藏） -->
        <div id="editorContainer" class="d-none mt-3">
            <div id="editor-container" style="height:300px;"></div>
            <div class="mt-2">
                <button class="btn btn-success btn-sm" onclick="saveContent()">儲存</button>
                <button class="btn btn-secondary btn-sm" onclick="cancelEdit()">取消</button>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE = "https://localhost:7030";
    const userId = "@userId";
    let quill;
    let currentHtml = "";

    // 初始化 Quill 編輯器
    function initQuill() {
        quill = new Quill('#editor-container', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    ['link', 'image']
                ],
                imageResize: {
                    modules: ['Resize', 'DisplaySize', 'Toolbar']
                }
            }
        });
    }

    // 讀取資料
    async function loadIntro() {
        const wrap = document.getElementById("storeContent");
        try {
            const res = await fetch(`${API_BASE}/api/bossstorecontent/${userId}`);
            if (!res.ok) throw new Error("讀取失敗");
            const data = await res.json();
            currentHtml = data?.contentHtml || "";
            wrap.innerHTML = currentHtml || "<span class='text-muted'>尚未設定個人介紹</span>";
        } catch (err) {
            console.error("讀取失敗:", err);
            wrap.innerHTML = "<span class='text-danger'>無法載入內容</span>";
        }
    }

    // 進入編輯模式
    document.getElementById("editIntroBtn").addEventListener("click", () => {
        document.getElementById("storeContent").classList.add("d-none");
        document.getElementById("editorContainer").classList.remove("d-none");

        if (!quill) initQuill();
        quill.root.innerHTML = currentHtml;
    });

    // 儲存內容
    async function saveContent() {
        const html = quill.root.innerHTML;
        try {
            const res = await fetch(`${API_BASE}/api/bossstorecontent/${userId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contentHtml: html })
            });

            if (res.ok) {
                alert("✅ 自定義內容已儲存");
                currentHtml = html;
                cancelEdit();
                document.getElementById("storeContent").innerHTML = html;
            } else {
                alert("❌ 儲存失敗");
            }
        } catch (err) {
            alert("❌ 儲存過程出錯");
            console.error(err);
        }
    }

    // 取消編輯
    function cancelEdit() {
        document.getElementById("storeContent").classList.remove("d-none");
        document.getElementById("editorContainer").classList.add("d-none");
    }

    // 初始化
    document.addEventListener("DOMContentLoaded", loadIntro);
</script>
