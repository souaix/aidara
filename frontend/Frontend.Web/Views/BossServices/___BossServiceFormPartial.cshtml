@model Frontend.Web.ViewModels.BossServiceEditVm

<div class="modal fade" id="bossServiceEditModal" tabindex="-1" aria-labelledby="bossServiceEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bossServiceEditModalLabel">
                    @((Model?.ItemId == null) ? "新增服務" : "編輯服務")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <form id="bossServiceForm" onsubmit="return false;">
                    <input type="hidden" id="userId" value="@Model.UserId" />
                    <input type="hidden" id="itemId" value="@Model.ItemId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">服務項目 ID</label>
                        <input type="text" id="itemIdInput" class="form-control"
                               value="@Model.ItemId" placeholder="例如 cleaning001" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">最低價格</label>
                            <input type="number" id="minPrice" class="form-control" min="0" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">最高價格</label>
                            <input type="number" id="maxPrice" class="form-control" min="0" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">服務範圍</label>
                        <div id="serviceAreas">
                            <div class="row g-2 mb-2 area-row">
                                <div class="col-md-5">
                                    <input type="number" class="form-control" placeholder="CityId" />
                                </div>
                                <div class="col-md-5">
                                    <input type="number" class="form-control" placeholder="DistrictId" />
                                </div>
                                <div class="col-md-2 d-flex align-items-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="this.closest('.area-row').remove()">刪除</button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addArea()">＋ 新增區域</button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary">儲存（暫時不動作）</button>
            </div>
        </div>
    </div>
</div>

<script>

    console.log("[Modal Partial] Script loaded");
    const modalEl = document.getElementById("bossServiceEditModal");
    if (!modalEl) {
        console.error("[Modal Partial] bossServiceEditModal not found in DOM!");
    } else {
        console.log("[Modal Partial] bossServiceEditModal found, initializing Bootstrap modal");
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
        console.log("[Modal Partial] Modal.show() executed");
    }

    function addArea() {
        const container = document.getElementById("serviceAreas");
        const row = document.createElement("div");
        row.className = "row g-2 mb-2 area-row";
        row.innerHTML = `
            <div class="col-md-5">
                <input type="number" class="form-control" placeholder="CityId" />
            </div>
            <div class="col-md-5">
                <input type="number" class="form-control" placeholder="DistrictId" />
            </div>
            <div class="col-md-2 d-flex align-items-center">
                <button type="button" class="btn btn-outline-danger btn-sm w-100" onclick="this.closest('.area-row').remove()">刪除</button>
            </div>
        `;
        container.appendChild(row);
    }

    // 當 partial 被 append 時自動顯示 modal
    const modalEl = document.getElementById("bossServiceEditModal");
    const modal = new bootstrap.Modal(modalEl);
    modal.show();
</script>
