@using System.Security.Claims
@{
    var uid = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

<!-- 成為達人 -->
<div class="text-center my-5">
    <h1 class="mb-3">成為達人</h1>
    <p class="text-muted mb-4">填寫以下資訊，免費註冊，開始提供服務</p>
    <button class="btn btn-primary" id="openRegisterModal" data-user-id="@uid">
        免費註冊
    </button>
</div>

<hr class="my-5" />

<!-- 商店自定義介紹 -->
<div class="mb-5">
    <h3>商店自定義介紹</h3>
    <p class="text-muted small">可以輸入文字、插入圖片（網址或上傳）</p>
    <div id="editor-container" style="height:300px; border:1px solid #ccc;"></div>
    <button type="button" class="btn btn-success mt-3" onclick="saveContent()">儲存自定義內容</button>
</div>

<!-- 註冊問卷 Modal -->
<div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">達人註冊問卷</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!-- Step 1：選分類 -->
                <div id="step1" class="step">
                    <h5>Step 1. 選擇服務分類 / 中分類 / 項目</h5>
                    <div class="row">
                        <div class="col-3 border-end">
                            <ul class="list-group" id="categoryList">
                                <li class="list-group-item text-muted">載入中...</li>
                            </ul>
                        </div>
                        <div class="col-4 border-end">
                            <ul class="list-group" id="subcategoryList">
                                <li class="list-group-item text-muted">請先選擇大分類</li>
                            </ul>
                        </div>
                        <div class="col-5">
                            <ul class="list-group" id="itemList">
                                <li class="list-group-item text-muted">請先選擇中分類</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Step 2：價格區間 -->
                <div id="step2" class="step d-none">
                    <h5>Step 2. 設定各項目的價格區間（幣別：TWD）</h5>
                    <p class="text-muted small mb-2">請為每個已勾選的項目輸入最低價與最高價。</p>
                    <div class="d-flex gap-2 align-items-end mb-3">
                        <div>
                            <label class="form-label mb-1">批次最低價</label>
                            <input type="number" min="0" id="batchMin" class="form-control" placeholder="例：500" />
                        </div>
                        <div>
                            <label class="form-label mb-1">批次最高價</label>
                            <input type="number" min="0" id="batchMax" class="form-control" placeholder="例：1500" />
                        </div>
                        <button class="btn btn-outline-secondary" id="applyBatch">套用到所有項目</button>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>服務項目</th>
                                    <th>最低價</th>
                                    <th>最高價</th>
                                    <th>檢查</th>
                                </tr>
                            </thead>
                            <tbody id="priceTbody">
                                <tr><td colspan="4" class="text-muted">尚未勾選任何服務項目</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Step 3：服務方式 -->
                <div id="step3" class="step d-none">
                    <h5>Step 3. 選擇服務方式</h5>
                    <div class="list-group" id="methodList">
                        <label class="list-group-item">
                            <input type="checkbox" class="method-check" value="我可以上門服務" />
                            我可以上門服務
                        </label>
                        <label class="list-group-item">
                            <input type="checkbox" class="method-check" value="客戶到我的據點" />
                            客戶到我的據點
                        </label>
                        <label class="list-group-item">
                            <input type="checkbox" class="method-check" value="網路/電話服務" />
                            網路/電話服務
                        </label>
                    </div>
                </div>

                <!-- Step 4：服務範圍 -->
                <div id="step4" class="step d-none">
                    <h5>Step 4. 選擇服務範圍</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <select id="citySelect" class="form-select">
                                <option value="">請選擇縣市</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <select id="districtSelect" class="form-select" multiple>
                                <option value="">請先選擇縣市</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Step 5：服務據點 -->
                <div id="step5" class="step d-none">
                    <h5>Step 5. 服務據點</h5>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <select id="addrCity" class="form-select">
                                <option value="">請選擇縣/市</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <select id="addrDistrict" class="form-select">
                                <option value="">請先選擇縣市</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-8">
                            <input id="addrStreet" class="form-control" placeholder="路名 (STREET)" />
                        </div>
                        <div class="col-md-4">
                            <input id="addrNo" class="form-control" placeholder="門牌號碼 (ADDRESS_NO)" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" id="prevStep" disabled>上一步</button>
                <button class="btn btn-primary" id="nextStep">下一步</button>
            </div>
        </div>
    </div>
</div>
