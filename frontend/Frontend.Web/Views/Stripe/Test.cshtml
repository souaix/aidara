@{
    ViewData["Title"] = "Stripe 測試頁";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h3 class="mb-4">Stripe SetupIntent（零授權）測試</h3>

    <div class="mb-3">
        <label class="form-label">Card holder name</label>
        <input id="cardholder-name" class="form-control" placeholder="Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Card Info</label>
        <div id="card-element" class="form-control"></div>
        <div id="card-errors" class="text-danger mt-2" role="alert"></div>
    </div>

    <button id="submit" class="btn btn-primary">確認驗證卡片（0 元）</button>
</div>

@section Scripts {
<script src="https://js.stripe.com/v3/"></script>
<script>
    // TODO: 換成你的 publishable key
    const stripe = Stripe("pk_test_51R6D8iCEyd5yyrHJ2eqSYY3nVcduCpZT4O4juzKu1Kgjks9nv7ewxYjbXr741pQ0MtjZg7bz7gGAvw7PpPmeDk1r00N4sxde9X");

    const elements = stripe.elements();
    const card = elements.create("card");
    card.mount("#card-element");

    card.on('change', function (event) {
        const displayError = document.getElementById('card-errors');
        displayError.textContent = event.error ? event.error.message : '';
    });

    document.getElementById('submit').addEventListener('click', async () => {
        const name = document.getElementById('cardholder-name').value || "Test User";

        // 向 Backend 建立 SetupIntent
        const resp = await fetch('/api/stripe/create-setup-intent', { method: 'POST' });
        if (!resp.ok) {
            alert('後端建立 SetupIntent 失敗，查看 console');
            console.error(await resp.text());
            return;
        }
        const data = await resp.json();
        const clientSecret = data.clientSecret || data.client_secret || data.clientsecret;

        // 驗證卡片
        const result = await stripe.confirmCardSetup(clientSecret, {
            payment_method: {
                card: card,
                billing_details: { name }
            }
        });

        if (result.error) {
            document.getElementById('card-errors').textContent = result.error.message;
        } else {
            console.log('SetupIntent succeeded', result.setupIntent);
            alert('驗證成功！payment_method id: ' + result.setupIntent.payment_method);
        }
    });
</script>
}
